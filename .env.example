# --- Agora ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
# --- Murf Falcon TTS ---
MURF_API_KEY=
MURF_VOICE_ID=en-IN-isha
MURF_LOCALE=en-IN
# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=Sarva Rakshak <onboarding@resend.dev>
DEMO_USER_EMAIL=
# dry-run (default, no email sent) | live
EMAIL_MODE=dry-run
# --- Server ---
PORT=8790
# Public https URL of this server (cloudflared tunnel), used by Agora to reach /llm
PUBLIC_BASE_URL=
# Shared secret Agora sends to our /llm endpoint
LLM_PROXY_SECRET=change-me
# live (OpenStreetMap) | offline
GEO_MODE=live
# Demo scenario: comma-separated banks whose freeze API is "down"
SCENARIO_BANK_OUTAGE=SBI
# Optional (unused for now)
AMADEUS_KEY=
AMADEUS_SECRET=

# Speech-to-text: deepgram (Nova-3, managed) | ares
ASR_VENDOR=deepgram
ASR_LANGUAGE=en-IN
# 1 = boost domain words (Sarva, Majestic, Aadhaar...)
ASR_KEYTERMS=0
